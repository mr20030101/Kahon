# these in Vercel's environment variables, never with a VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# or, with a Shared Drive: GOOGLE_SERVICE_ACCOUNT_EMAIL= and GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
